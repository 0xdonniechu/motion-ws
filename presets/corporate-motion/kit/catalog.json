{
 "_doc": "Từ vựng của preset corporate-motion. Scene chỉ gọi theo tên (Kit.make / Kit.fx / Kit.tx); cần thứ chưa có thì thêm vào đây + kit.js + ../demo/ trước. build-tokens.mjs --check-catalog kiểm khớp với kit.js (khi nạp) và demo. Prop có \"internal\": true (ease, reach, dur) CHỈ để kit dùng nội bộ: language cố định nên scene không được truyền; verify/--check-scenes báo lỗi.",
 "call": {
  "component": "Kit.make(name, parent, props) -> handle",
  "effect": "Kit.fx(name, tl, target, props)",
  "transition": "Kit.tx(name, tl, {from, to, at})"
 },
 "suits_values": [
  "wow-demo",
  "hanging-number",
  "authority",
  "metaphor",
  "checklist",
  "costly-detail",
  "lesson",
  "cta"
 ],
