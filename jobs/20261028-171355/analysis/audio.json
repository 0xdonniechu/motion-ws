 c\u00e1o qu\u00fd ba n\u0103m 2026 c\u1ee7a Tesla.", "tokens": [51476, 376, 13755, 272, 45202, 6476, 78, 421, 11822, 4773, 38098, 945, 10880, 11990, 13666, 13, 51654], "temperature": 0.0, "avg_logprob": -0.17490231768685097, "compression_ratio": 1.5889967637540454, "no_speech_prob": 0.06843643635511398}, {"id": 7, "seek": 0, "start": 25.8, "end": 28.96, "text": " Ti\u1ec1n m\u1eb7t v\u00e0 \u0111\u1ea7u t\u01b0\u01a1ng ng\u1eafn h\u1ea1n, 45 t\u1ef7 \u0111\u00f4.", "tokens": [51654, 20456, 26871, 275, 38248, 10274, 32573, 256, 24605, 6415, 42348, 276, 12937, 11, 6905, 256, 1297, 115, 2934, 2851, 13, 51812], "temperature": 0.0, "avg_logprob": -0.17490231768685097, "compression_ratio": 1.5889967637540454, "no_speech_prob": 0.06843643635511398}, {"id": 8, "seek": 2896, "start": 28.96, "end": 31.400000000000002, "text": " N\u1edf vai, 9,5 t\u1ef7.", "tokens": [50364, 426, 13755, 4405, 11, 1722, 11, 20, 256, 1297, 115, 13, 50486], "temperature": 0.0, "avg_logprob": -0.11840931061775453, "compression_ratio": 1.5454545454545454, "no_speech_prob": 0.016399046406149864}, {"id": 9, "seek": 2896, "start": 31.400000000000002, "end": 36.8, "text": " Nh\u01b0ng nh\u00ecn th\u00eam 2 d\u00f2ng n\u1eefa, ti\u1ec1n Tesla ph\u1ea3i tr\u1ea3 cho nh\u00e0 cung c\u1ea5p 17 t\u1ef7.", "tokens": [50486, 26390, 42509, 6245, 41320, 258, 13213, 568, 274, 36782, 35047, 11, 8757, 26871, 13666, 23394, 504, 7398, 1586, 35398, 269, 1063, 269, 47176, 3282, 256, 1297, 115, 13, 50756], "temperature": 0.0, "avg_logprob": -0.11840931061775453, "compression_ratio": 1.5454545454545454, "no_speech_prob": 0.016399046406149864}, {"id": 10, "seek": 2896, "start": 36.8, "end": 40.72, "text": " Ti\u1ec1n kh\u00e1ch h\u00e0ng c\u00f2n n\u1edf Tesla, ch\u1ec9 4,6 t\u1ef7.", "tokens": [50756, 20456, 26871, 7168, 39569, 48373, 31394, 297, 13755, 13666, 11, 33566, 1017, 11, 21, 256, 1297, 115, 13, 50952], "temperature": 0.0, "avg_logprob": -0.11840931061775453, "compression_ratio": 1.5454545454545454, "no_speech_