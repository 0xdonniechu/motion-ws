        {"use":"typing","at":0.73,"props":{"text":"Dashboard *đẹp* như phim.","caretHold":0.3}}
      ]
    },
    { "use": "dashboardCard", "slot": "card", "props": {"title":"Doanh thu tuần 12","kpi":{"label":"đạt kế hoạch"},"bars":[200,280,240,330,300,380]},
