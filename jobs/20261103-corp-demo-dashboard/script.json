    { "use": "listCard", "slot": "row2", "props": {"text":"*Ai* là người chốt?"},
      "effects": [
        {"use":"slideIn","at":2.4,"props":{"from":"right","fade":0}},
        {"use":"popIn","at":3.2,"target":"tick"}
      ]
    },
    { "use": "listCard", "slot": "row3", "props": {"text":"Con số nào *đổi được* hành động?"},
      "effects": [
        {"use":"slideIn","at":4.6,"props":{"from":"right","fade":0}},
        {"use":"popIn","at":5.4,"target":"tick"}
      ]
    }
   ]
  },
  {
