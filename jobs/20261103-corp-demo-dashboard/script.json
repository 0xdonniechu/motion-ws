    { "use": "text", "slot": "line", "props": {"role":"headline","text":"mà không ai dùng để *quyết*."},
      "effects": [
        {"use":"fadeUp","at":2.07}
      ]
    }
   ]
  },
  {
   "type": "lesson", "duration": 5, "layout": "rule-three-steps", "page": {"mode":"tint","grid":"line"}, "transition": {"use":"dissolve"},
   "items": [
    { "use": "text", "slot": "rule", "props": {"role":"headline"},
