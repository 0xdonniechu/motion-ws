        {"use":"slideIn","at":0.03,"props":{"fade":0}},
        {"use":"fadeUp","at":0.13,"target":"tag","props":{"y":0,"duration":0.2}},
        {"use":"countUp","at":0.7,"target":"num","props":{"to":72,"align":"center"}},
        {"use":"chartPop","at":0.83,"target":"bars"},
        {"use":"fadeUp","at":1.2,"target":"unit"},
        {"use":"fadeUp","at":1.37,"target":"bar","props":{"y":0}}
