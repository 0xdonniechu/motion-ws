      ]
    },
    { "use": "stepCard", "slot": "step1", "props": {"n":1,"text":"Quyết định"},
      "effects": [
        {"use":"slideIn","at":1.67,"props":{"from":"right","fade":0}}
      ]
    },
    { "use": "stepCard", "slot": "step2", "props": {"n":2,"text":"Câu hỏi"},
      "effects": [
        {"use":"slideIn","at":2.07,"props":{"from":"right","fade":0}}
      ]
    },
    { "use": "stepCard", "slot": "step3", "props": {"n":3,"text":"Biểu đồ"},
      "effects": [
        {"use":"slideIn","at":2.47,"props":{"from":"right","fade":0}}
      ]
    },
    { "use": "connector", "slot": "link1",
      "effects": [
        {"use":"fadeUp","at":1.87,"props":{"y":0}}
      ]
    },
    { "use": "connector", "slot": "link2",
      "effects": [
        {"use":"fadeUp","at":2.27,"props":{"y":0}}
      ]
    }
   ]
  },
  {
   "type": "cta", "duration": 6, "layout": "stat-ask-button", "page": {"mode":"white"},
   "items": [
    { "use": "statCard", "slot": "stat", "props": {"lead":"Trong 47 biểu đồ, giữ lại","unit":"con số."},
      "effects": [
        {"use":"slideIn","at":0.03,"props":{"fade":0}},
        {"use":"countUp","at":0.7,"target":"num","props":{"from":47,"to":1,"align":"center"}},
